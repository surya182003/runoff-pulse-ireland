# Copy to .env and adjust. No secrets are required: every data source used is open data.

# --- Backend (FastAPI) ---
# Comma-separated origins allowed by CORS (the Vite dev server by default).
RUNOFFPULSE_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Poll near-real-time feeds (OPW water levels, Met Éireann latest reports). Set to false for offline demos.
RUNOFFPULSE_LIVE_ENABLED=true
# Seconds to cache live upstream responses.
RUNOFFPULSE_LIVE_CACHE_SECONDS=900
# Timeout (seconds) for live upstream requests.
RUNOFFPULSE_HTTP_TIMEOUT=20
# Optional path overrides (defaults shown are relative to backend/).
# RUNOFFPULSE_DATA_DIR=backend/data
# RUNOFFPULSE_DB_PATH=backend/var/runoffpulse.sqlite3
# RUNOFFPULSE_UPLOAD_DIR=backend/var/uploads
# Maximum citizen-report photo size in bytes (5 MB).
RUNOFFPULSE_MAX_UPLOAD_BYTES=5242880

# --- Frontend (Vite) --- put this one in frontend/.env.local
# VITE_API_BASE_URL=http://localhost:8000
